# ─────────────────────────────────────────────────────────────────────────────
# BechaKena — environment template.
#
# Copy to `.env.local` for local tooling; a filled-in copy must never be
# committed. The Flutter app itself does NOT read this file at runtime — it is
# offline-first and takes its optional cloud values at build time via
# `--dart-define` (see HowToSetup.md §6). Everything here defaults to off.
# ─────────────────────────────────────────────────────────────────────────────

# ── Optional Cloud Plan (Supabase) ───────────────────────────────────────────
# The POS is fully functional with all of these empty; the cloud is additive.
# Project URL — e.g. https://abcdefghijkl.supabase.co
BECHAKENA_SUPABASE_URL=
# Public anon key. Safe to ship in the app bundle, but never commit a real one.
BECHAKENA_SUPABASE_ANON_KEY=
# Base URL of the Cloud Plan API / Edge Functions backing sync and SMS.
# The Supabase default is <project-url>/functions/v1.
BECHAKENA_API_BASE_URL=
# Ed25519 public key (Base64) used to verify offline license keys locally.
# Public by design — the private key stays on the license server.
BECHAKENA_LICENSE_PUBLIC_KEY=

# ── Server-side only — NEVER ship these in the app or the archive ────────────
# Supabase service-role key for Edge Functions / migrations. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# SMS gateway used by the due-reminder outbox (e.g. a local BD aggregator).
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=BechaKena

# ── Showcase site (Next.js static export) ────────────────────────────────────
# Canonical origin used for metadata/sitemap when the site is not on
# bkpos.vercel.app. Public value only.
NEXT_PUBLIC_SITE_URL=https://bkpos.vercel.app

# ── Docker / VPS showcase (docker-compose.yml at the repository root) ────────
# Host port that serves the landing page (/) and browser demo (/demo/).
DEMO_PORT=8080

# ── CI deployment (GitHub Actions repository secrets) ────────────────────────
# Used only by .github/workflows/showcase.yml when deploying to Vercel.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
